# Salin menjadi .env atau isi sebagai "environment variables" di layanan hosting.
PORT=3000
# Kosongkan DATABASE_URL untuk uji coba lokal (database tertanam di folder data/pgdata).
# Untuk penggunaan sungguhan, isi dengan alamat PostgreSQL:
# DATABASE_URL=postgres://pengguna:sandi@host:5432/namadb
# PGSSL=1
# Wajib 1 bila situs diakses lewat HTTPS (hosting sungguhan):
# COOKIE_SECURE=1
# Wajib 1 bila berada di belakang proxy/hosting (agar alamat IP pengunjung benar):
# TRUST_PROXY=1
# Opsional: kata sandi admin pertama. Bila kosong, dibuat acak dan ditampilkan sekali di layar.
# ADMIN_PASSWORD=
